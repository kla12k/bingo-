{
  "name": "wowbingo-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "concurrently \"next dev --webpack -p 4000\" \"tsx watch server/index.ts\"",
    "build": "next build --webpack",
    "start": "concurrently \"next start\" \"node server/dist/server/index.js\"",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "weekly:cards": "tsx scripts/generate-weekly-cards.ts",
    "backfill:failed-refunds": "tsx scripts/backfill-failed-game-refunds.ts",
    "server:build": "tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.38.0",
    "amqplib": "^0.10.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.4",
    "express": "^4.21.1",
    "framer-motion": "^12.34.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.563.0",
    "next": "16",
    "react": "^19",
    "react-dom": "^19",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
