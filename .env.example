# Database (add ?connection_limit=20&connect_timeout=30 if you see pool timeout errors)
DATABASE_URL="postgresql://user:password@localhost:5432/bingo?connection_limit=20&connect_timeout=30"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_DB=0
REDIS_PARTITION="bingo:"

# RabbitMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
# Retry delay when RabbitMQ is unreachable at socket server startup (ms)
RABBITMQ_RETRY_DELAY_MS="5000"

# Socket server (for client connection)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
# Docker / production: socket process port (must match reverse-proxy upstream for instant-backend)
SOCKET_PORT=3007
# Docker: "full" runs Next.js + socket; "socket" runs socket server only (instant-backend host)
RUN_MODE=full

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment API (external deposit backend)
PAYMENT_API_URL="http://localhost:8085"

# Auth (JWT)
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Stuck-game cron (socket server runs every N ms; API route can be called by external cron)
STUCK_GAME_CRON_INTERVAL_MS="180000"
CRON_SECRET="optional-secret-for-api-cron-stuck-games"
